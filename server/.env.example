PORT=5000
APP_MODE=assessment
CLIENT_ORIGIN=http://localhost:5173
AI_PROVIDER=gemini
SUMMARY_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
